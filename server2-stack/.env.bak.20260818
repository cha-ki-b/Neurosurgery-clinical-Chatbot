# Copy to .env and fill in the two secrets. Never commit the real .env - it is in .gitignore.
#
# This one file configures both the proxy and the agent service.
#
# The hospital, for reference:
#   Server 1  10.0.211.249   OpenMRS + Orthanc + the viewer, and the hospitalCA authority
#                            openmrs.hospital.lan / orthanc.hospital.lan / viewer.hospital.lan
#   Server 2  10.0.211.250   this machine: the GPU host and the clinical assistant
#                            agent.hospital.lan

# =============================================================================
# Proxy
# =============================================================================

# This machine's hostname. Must match the certificate signed by hospitalCA.
AGENT_SERVER_NAME=agent.hospital.lan
AGENT_SERVER_IP=10.0.211.250

# Server 1, and nothing else, may reach the assistant (ADR-12: browsers never talk to it).
# /32 means "this one address only".
OPENMRS_SERVER_CIDR=10.0.211.249/32

# 443 gives https://agent.hospital.lan with no port in the URL.
HTTPS_PORT=443
HTTP_PORT=80

# Upper bound on one chat turn. Keep OpenMRS's agentgateway.agentTimeoutMillis BELOW this
# (30000 ms in your settings, so 60s here is right) - the clinician should see
# "assistant indisponible" rather than the proxy cutting the connection underneath them.
AGENT_PROXY_READ_TIMEOUT=60s

# =============================================================================
# Clinical Agent Service
# =============================================================================
# The two secrets below come from OpenMRS: Administration -> Settings -> Agentgateway.
# The service refuses to start without them.

OPENMRS_BASE_URL=https://openmrs.hospital.lan/openmrs
OPENMRS_TIMEOUT_SECONDS=20
OPENMRS_VERIFY_TLS=true

# Copy the "Channel Secret" field from OpenMRS, exactly, with no extra spaces or line breaks.
AGENT_CHANNEL_SECRET=WOuGVqbn0pYh2zivMF3yoEi9BoyoUly+CK5SMZX9fq9snWiIr+UdJRNMcwuIov9r

# Copy the "Signing Public Key" field from OpenMRS - the PUBLIC one, as ONE single line with no
# spaces or newlines. The box in OpenMRS wraps it visually; that wrapping is not part of the key.
# Never copy "Signing Private Key": whoever holds it can impersonate any user in the hospital.
OPENMRS_JWT_PUBLIC_
JWT_ISSUER=openmrs-agentgateway
JWT_AUDIENCE=clinical-agent-service

# Filled in by docker-compose.yml; listed here so it is visible. This is Server 1's authority,
# which is what lets the agent verify openmrs.hospital.lan instead of trusting it blindly.
# OPENMRS_CA_BUNDLE=/etc/ssl/hospital/hospitalCA.crt

CONVERSATION_TTL_SECONDS=900
MAX_CONVERSATIONS=500
CAPABILITY_REFRESH_SECONDS=3600

# Leave false until patientview exposes /ws/rest/v1/patientview/... (architecture 4.3), and add
# that prefix to agentgateway.auditedPathPrefixes at the same time. Both, or the tool stays off.
PATIENTVIEW_TOOLS_ENABLED=false

OPENMRS_PATIENT_IDENTIFIER_SYSTEM=

# Prompts contain patient information. The reviewable record belongs in OpenMRS's
# agentgateway_operation_log, not in this machine's log files. Turn on only while debugging.
LOG_PROMPTS=false

# =============================================================================
# OHIF — only used with docker-compose.ohif.yml
# =============================================================================
# NOTE: viewer.hospital.lan is already served by Server 1, which is the better place for it
# (it sits next to Orthanc, so no cross-origin problem). Only set this if you deliberately move
# the viewer here. See docker-compose.ohif.yml.
OHIF_SERVER_NAME=viewer2.hospital.lan
