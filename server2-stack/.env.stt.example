# Dictation service — its OWN environment, separate from .env on purpose.
#
# WHY THIS FILE EXISTS
#
# `env_file: .env` hands a container the WHOLE file. With one shared .env, stt-gateway
# received AGENT_CHANNEL_SECRET and clinical-agent received STT_CHANNEL_SECRET — which
# silently defeated the entire point of giving the two services separate secrets
# (STT-PLAN.md §3/Q2). Found in the 2026-09-02 audit; see STT/SECURITY-AUDIT.md.
#
# The rule: a service's environment contains what that service needs, and nothing else.
#
# Only the variables docker compose has to INTERPOLATE (STT_SERVER_NAME, STT_VLLM_TAG,
# STT_MODEL_PATH, STT_MODEL, STT_GPU_FRACTION, STT_PROXY_READ_TIMEOUT) stay in .env, and
# every one of those is non-secret.

# --- trust boundary ---------------------------------------------------------
STT_CHANNEL_SECRET=
STT_JWT_AUDIENCE=stt-service
STT_TOKEN_PURPOSE=stt
JWT_ISSUER=openmrs-agentgateway

# The signing PUBLIC key. Safe to duplicate — it is public, and duplicating it is
# cheaper than a second key lifecycle.
OPENMRS_JWT_PUBLIC_KEY=

# --- engine and limits ------------------------------------------------------
STT_MODEL=Qwen3-ASR-0.6B
STT_LANGUAGE=fr
STT_MAX_UTTERANCE_SECONDS=30
STT_MIN_UTTERANCE_MS=300
STT_MAX_CONCURRENT_PER_USER=1
STT_SILENCE_RMS_THRESHOLD=200
STT_BIAS_LEXICON_PATH=/etc/stt/lexicon-neurochir.txt

# Transcripts are PHI. Audio is never logged at any level — there is no setting.
LOG_TRANSCRIPTS=false
