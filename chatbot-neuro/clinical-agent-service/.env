# Copy to .env and fill in. Both AGENT_CHANNEL_SECRET and OPENMRS_JWT_PUBLIC_KEY come from the
# agentgateway module's settings in OpenMRS - the service refuses to start without them.

# --- OpenMRS (Server 1) -------------------------------------------------------
OPENMRS_BASE_URL=https://openmrs.hospital.lan/openmrs
OPENMRS_TIMEOUT_SECONDS=20
# Set to false only while testing against a self-signed certificate.
OPENMRS_VERIFY_TLS=true

# --- Channel trust ------------------------------------------------------------
# Must match the agentgateway.channelSecret global property in OpenMRS, exactly.
# Generate with: openssl rand -base64 48
AGENT_CHANNEL_SECRET=

# --- User trust ---------------------------------------------------------------
# The value of the agentgateway.signingPublicKey global property (base64, one line).
# OpenMRS generates the key pair on first start; the private half never leaves it.
OPENMRS_JWT_PUBLIC_KEY=
JWT_ISSUER=openmrs-agentgateway
JWT_AUDIENCE=clinical-agent-service

# --- Conversation buffer (in memory, never persisted) -------------------------
CONVERSATION_TTL_SECONDS=900
MAX_CONVERSATIONS=500

# --- Capability discovery -----------------------------------------------------
# How often to re-read /ws/fhir2/R4/metadata. Re-read after every fhir2 upgrade.
CAPABILITY_REFRESH_SECONDS=3600

# --- Neurosurgery-specific tools (ADR-10's second family) ---------------------
# Leave false until patientview exposes /ws/rest/v1/patientview/... (architecture 4.3), and
# remember to add that prefix to agentgateway.auditedPathPrefixes at the same time.
PATIENTVIEW_TOOLS_ENABLED=false

# --- Patient creation ---------------------------------------------------------
# The identifier system this hospital issues patient identifiers under, if any.
OPENMRS_PATIENT_IDENTIFIER_SYSTEM=

# --- Logging ------------------------------------------------------------------
# Off by default: prompts contain PHI, and the durable, reviewable record of what the assistant
# did belongs in OpenMRS's agentgateway_operation_log, not in this server's log file.
LOG_PROMPTS=false
